# Copy to .env on the VPS only (gitignored). Never commit real values.
# Pooler URL for role `verifier` (LOGIN set by owner on Supabase) — not service_role.
# Session pooler (port 5432 on the pooler host, user verifier.<project-ref>): one long connection.
VERIFIER_DATABASE_URL=
WORKER_ID=vps-1
# Optional: for verify-pack smoke once verify_<n>.pck exists in ./packs
SIM_VERSION=
# Container mode: smoke (default) | worker | verify-pack. Rollback = smoke.
VERIFIER_COMMAND=smoke
